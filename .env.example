# Скопируйте этот файл в .env, если хотите переопределить настройки.
# Ключ API здесь НЕ хранится — он лежит в api_key.txt.

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
PORT=8080

# Необязательно: путь к файлу с ключом (по умолчанию api_key.txt)
# DEEPSEEK_API_KEY_FILE=api_key.txt
